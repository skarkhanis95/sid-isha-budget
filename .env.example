# Turso Database Configuration (Required)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Authentication Secret (Required) - generate with: openssl rand -base64 32
JWT_SECRET=

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourHouseholdBot
# Only needed if you register /api/telegram/webhook with Telegram's setWebhook (secret_token param).
# Not needed for the telegram:poll long-polling script.
TELEGRAM_WEBHOOK_SECRET=

# Daily Cron Job Authorization Secret (Optional)
CRON_SECRET=your-cron-secret-token
